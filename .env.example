# Copy to repo root as `.env` and adjust. Services read their own `services/*/.env` if present.

# ---------- Data plane (docker-compose) ----------
OPENSEARCH_URL=http://localhost:9200
POSTGRES_URL=postgresql://commerce:commerce@localhost:5432/commerce_ai
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=commerce
MINIO_SECRET_KEY=commercecommerce
MINIO_BUCKET=catalog-feeds

# ---------- NestJS gateway (services/api-gateway) ----------
PORT=3000
SEARCH_ORCHESTRATOR_URL=http://127.0.0.1:8001
CATALOG_INGESTION_URL=http://127.0.0.1:8002
EMBEDDING_WORKER_URL=http://127.0.0.1:8003
INDEXING_WORKER_URL=http://127.0.0.1:8004
ANALYTICS_SERVICE_URL=http://127.0.0.1:8005
AGENT_SERVICE_URL=http://127.0.0.1:8006

# Stub API key for local dev (gateway accepts any `pk_` / `sk_` prefix in dev)
COMMERCE_AI_DEV_MODE=true

# Set false to run `uv run commerce-ingest-worker` as a separate process
EMBEDDED_INGEST_WORKER=true

# ---------- Python services (defaults) ----------
PRODUCTS_INDEX_ALIAS=commerce-products
OPENAI_API_KEY=
EMBEDDING_MODEL=multilingual-e5-small
