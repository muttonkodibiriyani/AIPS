# Copied to apps/showcase/.env.local for local dev (do not commit secrets)
COMMERCE_GATEWAY_URL=http://localhost:3000
COMMERCE_API_KEY=pk_stub

# When COMMERCE_GATEWAY_URL is unset, search reads lib/demo-catalog.json (built from data/catalog.csv in prebuild).
# Only if catalog.csv is empty: set true for a tiny built-in stub list.
SHOWCASE_DEMO_SEARCH=false
