# Copied to apps/showcase/.env.local for local dev (do not commit secrets)
COMMERCE_GATEWAY_URL=http://localhost:3000
COMMERCE_API_KEY=pk_stub

# When COMMERCE_GATEWAY_URL is unset, search reads lib/demo-catalog.json (built during prebuild from data/*.csv.gz, catalog.csv, SHOWCASE_CATALOG_CSV, or SHOWCASE_CATALOG_URL).

# Place a large export locally without committing: any name like apps/showcase/data/your-export.csv.gz (gitignored *.csv.gz) or set SHOWCASE_CATALOG_CSV.

# SHOWCASE_DEMO_ROW_LIMIT=0 matches vercel.json: stream all rows into demo-catalog.json (very large builds). Set e.g. 200000 on Vercel if the build hits memory/time limits.

# --- Model intent (required for CSV demo on Vercel unless you opt out) ---
# Production: set GEMINI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY and/or OPENROUTER_API_KEY.
# CI / local without keys: SHOWCASE_ALLOW_LEXICAL_ONLY=true
# If all model calls fail (timeout/quota), search returns 503 unless SHOWCASE_LLM_INTENT_STRICT=false
# SHOWCASE_LLM_INTENT_STRICT=true
# SHOWCASE_LLM_INTENT=false  # disables outbound LLM calls (only with SHOWCASE_ALLOW_LEXICAL_ONLY=true for CSV path)

# Hourly redeploy (Vercel Pro cron): set CRON_SECRET + VERCEL_DEPLOY_HOOK_URL. GitHub Action showcase-deploy-hook.yml also runs hourly.
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
# CRON_SECRET=random-long-string

# Sparse-result recovery (Medium-style LLM alternate queries): if lexical matches < SHOWCASE_SPARSE_HINT_MIN_RESULTS, ask the LLM for ~5 clickable search phrases. Uses GEMINI/OpenRouter credits; TTL cache reduces repeat cost.
# SHOWCASE_SPARSE_LLM_HINTS=true
# SHOWCASE_SPARSE_HINT_MIN_RESULTS=5
# SHOWCASE_LLM_SUGGEST_CACHE_TTL_MS=120000
# Optional: OPENROUTER_SPARSE_MODEL → defaults to OPENROUTER_MODEL.

# Batch catalog lexicon (CI + local npm run catalog:lexicon-batch): merges into search_text via prebuild when
# SHOWCASE_MERGE_LEXICON_SLICES is true (see root package.json scripts + generate-demo-catalog-from-csv.mjs).
# SHOWCASE_MERGE_LEXICON_SLICES=true
# SHOWCASE_LEXICON_MERGE_CHAR_CAP=5500
# CATALOG_LEX_BATCH_MIN=5000
# CATALOG_LEX_BATCH_MAX=10000

