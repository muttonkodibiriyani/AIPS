# Copied to apps/showcase/.env.local for local dev (do not commit secrets)
COMMERCE_GATEWAY_URL=http://localhost:3000
COMMERCE_API_KEY=pk_stub

# When COMMERCE_GATEWAY_URL is unset, search reads lib/demo-catalog.json (built from data/catalog.csv in prebuild).

# Remote full catalogue (recommended for large exports): HTTPS URL to CSV or .csv.gz — prebuild streams into data then JSON.
# SHOWCASE_CATALOG_URL=https://example.com/releases/catalog_abc123.csv.gz

# Include every row in demo-catalog.json at build (heavy). Overrides apps/showcase/vercel.json default cap when set in Vercel.
# SHOWCASE_DEMO_ROW_LIMIT=0

# LLM intent (optional): Gemini and/or OpenRouter. OpenRouter can run any listed model (DeepSeek, Claude, Llama, …).
# GEMINI_API_KEY=…
# OPENROUTER_API_KEY=…
# OPENROUTER_MODEL=google/gemini-2.0-flash-001:free
# Second OpenRouter model merges in parallel when SHOWCASE_LLM_PARALLEL is not false:
# OPENROUTER_MODEL_SECOND=deepseek/deepseek-chat:free
# SHOWCASE_LLM_INTENT=true

# Only if catalog.csv is empty: set true for a tiny built-in stub list.
SHOWCASE_DEMO_SEARCH=false
