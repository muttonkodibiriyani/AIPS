{
  "name": "commerce-ai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/shared-types",
    "packages/ui-components",
    "services/api-gateway"
  ],
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "showcase:demo-catalog": "node scripts/generate-demo-catalog-from-csv.mjs",
    "catalog:lexicon-batch": "node scripts/catalog-lexicon-batch.mjs",
    "lexical-gateway": "npm run start -w @commerce-ai/lexical-catalog-gateway",
    "types:generate": "pnpm exec openapi-typescript contracts/openapi.yaml -o packages/shared-types/src/generated/api.ts --export-type --path-params-as-types",
    "gateway:dev": "pnpm --filter @commerce-ai/api-gateway start:dev",
    "showcase:dev": "pnpm --filter @commerce-ai/showcase dev",
    "showcase:build": "pnpm --filter @commerce-ai/showcase build"
  },
  "devDependencies": {
    "csv-parse": "^5.6.0",
    "openapi-typescript": "^7.4.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
